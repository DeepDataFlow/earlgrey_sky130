# pinmux APR SDC constraints (auto-generated)
create_clock -name clk_i -period 41.67 [get_ports clk_i]
create_clock -name clk_aon_i -period 5000 [get_ports clk_aon_i]

# Each clock group below is a genuinely separate physical clock root
# in the real chip (per OpenTitan's clock tree); CDC between them is
# handled by synchronizer flops in the RTL, not by timing closure.
set_clock_groups -asynchronous -group {clk_i} -group {clk_aon_i}

# --- Input Delays ---
set_input_delay 1 -clock clk_i [get_ports usbdev_wake_ack_i]
set_input_delay 1 -clock clk_i [get_ports usbdev_suspend_req_i]
set_input_delay 1 -clock clk_i [get_ports usbdev_dppullup_en_i]
set_input_delay 1 -clock clk_i [get_ports usbdev_dnpullup_en_i]
set_input_delay 1 -clock clk_i [get_ports {tl_i[*]}]
set_input_delay 1 -clock clk_i [get_ports strap_en_override_i]
set_input_delay 1 -clock clk_i [get_ports strap_en_i]
set_input_delay 1 -clock clk_i [get_ports sleep_en_i]
set_input_delay 1 -clock clk_i [get_ports {scanmode_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {rv_jtag_i[*]}]
set_input_delay 1 -clock clk_i [get_ports rst_sys_ni]
set_input_delay 1 -clock clk_i [get_ports rst_ni]
set_input_delay 1 -clock clk_aon_i [get_ports rst_aon_ni]
set_input_delay 1 -clock clk_i [get_ports {periph_to_mio_oe_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {periph_to_mio_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {periph_to_dio_oe_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {periph_to_dio_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {mio_in_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_jtag_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_hw_debug_en_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_hw_debug_clr_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_escalate_en_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_dft_en_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {lc_check_byp_en_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {dio_in_i[*]}]
set_input_delay 1 -clock clk_i [get_ports {dft_jtag_i[*]}]
set_input_delay 1 -clock clk_i [get_ports dft_hold_tap_sel_i]
set_input_delay 1 -clock clk_i [get_ports {alert_rx_i[*]}]

# --- Output Delays ---
set_output_delay 1 -clock clk_i [get_ports usbdev_wake_detect_active_o]
set_output_delay 1 -clock clk_i [get_ports usbdev_sense_lost_o]
set_output_delay 1 -clock clk_i [get_ports usbdev_bus_reset_o]
set_output_delay 1 -clock clk_i [get_ports usbdev_bus_not_idle_o]
set_output_delay 1 -clock clk_i [get_ports usb_wkup_req_o]
set_output_delay 1 -clock clk_i [get_ports usb_dppullup_en_o]
set_output_delay 1 -clock clk_i [get_ports usb_dnpullup_en_o]
set_output_delay 1 -clock clk_i [get_ports {tl_o[*]}]
set_output_delay 1 -clock clk_i [get_ports {rv_jtag_o[*]}]
set_output_delay 1 -clock clk_i [get_ports {pinmux_hw_debug_en_o[*]}]
set_output_delay 1 -clock clk_i [get_ports pin_wkup_req_o]
set_output_delay 1 -clock clk_i [get_ports {mio_to_periph_o[*]}]
set_output_delay 1 -clock clk_i [get_ports {mio_out_o[*]}]
set_output_delay 1 -clock clk_i [get_ports {mio_oe_o[*]}]
