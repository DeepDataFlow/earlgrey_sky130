# usbdev APR SDC constraints (auto-generated)
create_clock -name clk_i -period 20.83 [get_ports clk_i]
create_clock -name clk_aon_i -period 5000 [get_ports clk_aon_i]

# Each clock group below is a genuinely separate physical clock root
# in the real chip (per OpenTitan's clock tree); CDC between them is
# handled by synchronizer flops in the RTL, not by timing closure.
set_clock_groups -asynchronous -group {clk_i} -group {clk_aon_i}

# --- Input Delays ---
set_input_delay 1 -clock clk_i [get_ports usb_rx_d_i]
set_input_delay 1 -clock clk_aon_i [get_ports usb_aon_wake_detect_active_i]
set_input_delay 1 -clock clk_aon_i [get_ports usb_aon_sense_lost_i]
set_input_delay 1 -clock clk_aon_i [get_ports usb_aon_bus_reset_i]
set_input_delay 1 -clock clk_aon_i [get_ports usb_aon_bus_not_idle_i]
set_input_delay 1 -clock clk_i [get_ports {tl_i[*]}]
set_input_delay 1 -clock clk_i [get_ports rst_ni]
set_input_delay 1 -clock clk_aon_i [get_ports rst_aon_ni]
set_input_delay 1 -clock clk_i [get_ports {ram_cfg_i[*]}]
set_input_delay 1 -clock clk_i [get_ports cio_usb_dp_i]
set_input_delay 1 -clock clk_i [get_ports cio_usb_dn_i]
set_input_delay 1 -clock clk_i [get_ports cio_sense_i]
set_input_delay 1 -clock clk_i [get_ports {alert_rx_i[*]}]

# --- Output Delays ---
set_output_delay 1 -clock clk_i [get_ports usb_tx_use_d_se0_o]
set_output_delay 1 -clock clk_i [get_ports usb_tx_se0_o]
set_output_delay 1 -clock clk_i [get_ports usb_tx_d_o]
set_output_delay 1 -clock clk_i [get_ports usb_rx_enable_o]
set_output_delay 1 -clock clk_i [get_ports usb_ref_val_o]
set_output_delay 1 -clock clk_i [get_ports usb_ref_pulse_o]
set_output_delay 1 -clock clk_i [get_ports usb_dp_pullup_o]
set_output_delay 1 -clock clk_i [get_ports usb_dn_pullup_o]
set_output_delay 1 -clock clk_aon_i [get_ports usb_aon_wake_ack_o]
set_output_delay 1 -clock clk_aon_i [get_ports usb_aon_suspend_req_o]
set_output_delay 1 -clock clk_i [get_ports {tl_o[*]}]
set_output_delay 1 -clock clk_i [get_ports ram_cfg_o]
set_output_delay 1 -clock clk_i [get_ports intr_rx_pid_err_o]
set_output_delay 1 -clock clk_i [get_ports intr_rx_full_o]
set_output_delay 1 -clock clk_i [get_ports intr_rx_crc_err_o]
set_output_delay 1 -clock clk_i [get_ports intr_rx_bitstuff_err_o]
set_output_delay 1 -clock clk_i [get_ports intr_powered_o]
set_output_delay 1 -clock clk_i [get_ports intr_pkt_sent_o]
set_output_delay 1 -clock clk_i [get_ports intr_pkt_received_o]
set_output_delay 1 -clock clk_i [get_ports intr_link_suspend_o]
set_output_delay 1 -clock clk_i [get_ports intr_link_resume_o]
set_output_delay 1 -clock clk_i [get_ports intr_link_reset_o]
set_output_delay 1 -clock clk_i [get_ports intr_link_out_err_o]
set_output_delay 1 -clock clk_i [get_ports intr_link_in_err_o]
set_output_delay 1 -clock clk_i [get_ports intr_host_lost_o]
set_output_delay 1 -clock clk_i [get_ports intr_frame_o]
set_output_delay 1 -clock clk_i [get_ports intr_disconnected_o]
set_output_delay 1 -clock clk_i [get_ports intr_av_setup_empty_o]
set_output_delay 1 -clock clk_i [get_ports intr_av_overflow_o]
set_output_delay 1 -clock clk_i [get_ports intr_av_out_empty_o]
set_output_delay 1 -clock clk_i [get_ports cio_usb_dp_o]
set_output_delay 1 -clock clk_i [get_ports cio_usb_dp_en_o]
set_output_delay 1 -clock clk_i [get_ports cio_usb_dn_o]
set_output_delay 1 -clock clk_i [get_ports cio_usb_dn_en_o]
set_output_delay 1 -clock clk_i [get_ports {alert_tx_o[*]}]
