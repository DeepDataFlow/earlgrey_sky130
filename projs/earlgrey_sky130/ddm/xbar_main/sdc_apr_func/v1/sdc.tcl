# xbar_main APR SDC constraints (auto-generated)
create_clock -name clk_usb_i -period 20.83 [get_ports clk_usb_i]
create_clock -name clk_spi_host1_i -period 20.83 [get_ports clk_spi_host1_i]
create_clock -name clk_spi_host0_i -period 10.417 [get_ports clk_spi_host0_i]
create_clock -name clk_main_i -period 6.67 [get_ports clk_main_i]
create_clock -name clk_fixed_i -period 41.67 [get_ports clk_fixed_i]

# Each clock group below is a genuinely separate physical clock root
# in the real chip (per OpenTitan's clock tree); CDC between them is
# handled by synchronizer flops in the RTL, not by timing closure.
set_clock_groups -asynchronous -group {clk_usb_i} -group {clk_spi_host1_i} -group {clk_spi_host0_i} -group {clk_main_i} -group {clk_fixed_i}

# --- Input Delays ---
set_input_delay 1 -clock clk_usb_i [get_ports {tl_usbdev_i[*]}]
set_input_delay 1 -clock clk_usb_i [get_ports {tl_sram_ctrl_sec__regs_i[*]}]
set_input_delay 1 -clock clk_usb_i [get_ports {tl_sram_ctrl_sec__ram_i[*]}]
set_input_delay 1 -clock clk_main_i [get_ports {tl_sram_ctrl_main__regs_i[*]}]
